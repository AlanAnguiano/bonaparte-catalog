<% content_for :title, "Enriquecer catálogo" %>

<main class="page">
  <h1 class="brand">Bonaparte Catalog</h1>
  <p class="lede">
    Sube un Excel con hoja <strong>Origen</strong>. El sistema resuelve contra evidencia
    versionada (sin red ni LLM) y descarga el catálogo enriquecido.
  </p>

  <% if @error.present? %>
    <p class="alert"><%= @error %></p>
  <% end %>

  <section class="card">
    <h2 class="card-title">Procesar archivo</h2>

    <%= form_with url: enrichments_path,
                  method: :post,
                  multipart: true,
                  data: { turbo: false } do %>
      <div class="field">
        <label for="workbook">Seleccionar archivo</label>
        <input id="workbook"
               type="file"
               name="workbook"
               accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
               required>
      </div>

      <p class="actions">
        <button type="submit" class="btn">Descargar</button>
      </p>
    <% end %>
  </section>

  <p class="hint">
    También puedes usar la CLI:
    <code>bin/rails catalog:enrich</code>
  </p>

  <p class="footnote">Más detalle en el README y la carpeta <code>docs/</code>.</p>
</main>
